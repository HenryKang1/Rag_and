<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:padding="8dp"
    tools:context=".MainActivity">

    <!-- Chat view with floating clear button -->
    <FrameLayout
        android:id="@+id/chatFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ragControlsRow1"
        android:background="@color/frame_layout_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layout_marginStart="10dp"
            android:padding="8dp" />


    </FrameLayout>

    <!-- Row 1: Toggles -->
    <LinearLayout
        android:id="@+id/ragControlsRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/chatFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Thinking mode toggle -->
        <CheckBox
            android:id="@+id/thinkingToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thinking Mode"
            android:textSize="12sp"
            android:padding="4dp"
            android:textColor="#FFFFFF"
            android:visibility="visible"
            android:checked="false"
            android:gravity="center_vertical" />

        <!-- RAG Enable Toggle -->
        <CheckBox
            android:id="@+id/ragToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable RAG"
            android:textSize="12sp"
            android:padding="4dp"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:gravity="center_vertical" />

    </LinearLayout>

    <!-- Row 2: Operation Buttons -->
    <LinearLayout
        android:id="@+id/ragControlsRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/ragControlsRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Upload Document Button -->
        <Button
            android:id="@+id/uploadButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Upload Doc"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:backgroundTint="#4A5568"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <!-- Clear Index Button -->
        <Button
            android:id="@+id/clearIndexButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Clear Index"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Input + Send/Stop button combo -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/ragControlsRow2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/userInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_edittext"
            android:gravity="top|start"

            android:hint="Enter your prompt"
            android:textColorHint="#AAAAAA"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="10"
            android:minLines="5"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="10dp"
            android:textSize="16sp" />



        <FrameLayout
            android:id="@+id/sendStopSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:padding="2dp">

            <Button
                android:id="@+id/sendButton"
                style="@style/SendButton"
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_height="50dp"
                android:text="Send" />

            <Button
                android:id="@+id/stopButton"
                style="@style/StopButton"
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_height="50dp"
                android:text="Stop"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
